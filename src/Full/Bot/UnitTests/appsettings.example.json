{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "ConnectionStrings": {
    "Storage": "DefaultEndpointsProtocol=https;AccountName=<your-storage-account>;AccountKey=<your-storage-key>;EndpointSuffix=core.windows.net"
  },
  "EnableRBAC": false,
  "StorageAccountName": "<your-storage-account>",
  "StorageAuthConfig": {
    "ClientId": "<optional-service-principal-client-id>",
    "ClientSecret": "<optional-service-principal-secret>",
    "TenantId": "<optional-tenant-id>"
  },
  "GraphConfig": {
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-client-id>",
    "ClientSecret": "<your-client-secret>"
  }
}
